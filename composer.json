{
    "name": "nexphp/nexphp",
    "description": "NexPHP — Next-generation PHP framework designed for modern runtimes, developer ergonomics, and AI vibe-coding",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Nex\\Contracts\\": "packages/contracts/src/",
            "Nex\\Container\\": "packages/container/src/",
            "Nex\\Config\\": "packages/config/src/",
            "Nex\\Http\\": "packages/http/src/",
            "Nex\\Routing\\": "packages/routing/src/",
            "Nex\\Middleware\\": "packages/middleware/src/",
            "Nex\\Foundation\\": "packages/foundation/src/",
            "Nex\\Runtime\\Contracts\\": "packages/runtime-contracts/src/",
            "Nex\\Runtime\\Fpm\\": "packages/runtime-fpm/src/",
            "Nex\\Runtime\\Worker\\": "packages/runtime-worker/src/",
            "Nex\\Runtime\\FrankenPhp\\": "packages/runtime-frankenphp/src/",
            "Nex\\Concurrency\\Contracts\\": "packages/concurrency-contracts/src/",
            "Nex\\Concurrency\\": "packages/concurrency/src/",
            "Nex\\HttpClient\\Contracts\\": "packages/http-client-contracts/src/",
            "Nex\\HttpClient\\": "packages/http-client/src/",
            "Nex\\WorkerHealth\\": "packages/worker-health/src/",
            "Nex\\Console\\": "packages/console/src/",
            "Nex\\Database\\Contracts\\": "packages/database-contracts/src/",
            "Nex\\Database\\": "packages/database/src/",
            "Nex\\Database\\Migrations\\": "packages/database-migrations/src/",
            "Nex\\Validation\\": "packages/validation/src/",
            "Nex\\Auth\\Contracts\\": "packages/auth-contracts/src/",
            "Nex\\Auth\\": "packages/auth/src/",
            "Nex\\Authorization\\": "packages/authorization/src/",
            "Nex\\Testing\\": "packages/testing/src/",
            "Nex\\Events\\Contracts\\": "packages/event-contracts/src/",
            "Nex\\Events\\": "packages/events/src/",
            "Nex\\Queue\\Contracts\\": "packages/queue-contracts/src/",
            "Nex\\Queue\\": "packages/queue/src/",
            "Nex\\Scheduler\\": "packages/scheduler/src/",
            "Nex\\Filesystem\\Contracts\\": "packages/filesystem-contracts/src/",
            "Nex\\Filesystem\\": "packages/filesystem/src/",
            "Nex\\Mail\\Contracts\\": "packages/mail-contracts/src/",
            "Nex\\Mail\\": "packages/mail/src/",
            "Nex\\Notifications\\": "packages/notifications/src/",
            "Nex\\Security\\": "packages/security/src/",
            "Nex\\Logging\\": "packages/logging/src/",
            "Nex\\Metrics\\": "packages/metrics/src/",
            "Nex\\Health\\": "packages/health/src/",
            "Nex\\Resilience\\": "packages/resilience/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nex\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
